#==========================================
# Временные папки и кэш движка (Игнорировать обязательно)
#==========================================
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Кэш шейдеров и локальные настройки
.idea/
.vs/
.vscode/
*.sln
*.suo
*.xsd
*.user
*.userosscache
*.sln.docstates

# Папки сборки и исходников плагинов (бинарники плагинов компилируются локально)
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Автоматически генерируемые файлы проекта
*.xcodeproj
*.xcworkspace

#==========================================
# Архивы и автосохранения движка
#==========================================
*.bak
*.log
*.patch
*.crash

#==========================================
# Специфичные папки платформ (при сборке)
#==========================================
Build/
Donut/
Staging/

# Файлы пользовательских настроек (локальные раскладки окон и т.д.)
Saved/Config/Windows/*.ini
Saved/Config/WindowsEditor/*.ini
Saved/Config/Mac/*.ini
Saved/Config/MacEditor/*.ini
